<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#006C51</color>

    <!-- Window theme for the launch splash; switches to the theme below afterwards. -->
    <style name="Theme.CurrencyConverter.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CurrencyConverter</item>
    </style>

    <style name="Theme.CurrencyConverter" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
